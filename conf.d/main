#!/bin/bash -ex
# The odoo layer (handbook decision 0059, step 6): Odoo 18.0 on the lnpp
# layer. It runs in the image chroot, after the overlay is in place.
#
# 1. The source is a checkout of the Keel-Linux/odoo snapshot at a tag,
#    and the build stops if the commit is not the one pinned here. The
#    snapshot is one commit of the upstream branch 18.0, so the pinned
#    commit names the upstream commit too.
# 2. The database role odoo has no password: it connects on the unix socket
#    and PostgreSQL authenticates the operating system user (peer).
# 3. The database odoo is installed here with the base module, so the first
#    boot is short. Attachments go to the database (ir_attachment.location),
#    so the pair of decision 0054 carries them: a failover loses no file.
#    The first boot hook renews the secrets that every image shares.
# 4. wkhtmltopdf prints the reports. Debian 13 has no such package, and
#    Odoo needs the build with patched qt: only that one prints the header
#    and the footer of a report. The build installs the .deb of the
#    upstream packaging project at a pinned digest (decision 0022 plans a
#    package of the Keel archive for it). It lands in /usr/local.

ODOO_URL=https://git.pop.coop/Keel-Linux/odoo.git
ODOO_TAG=snapshot-18.0-1f2b50ade7a1
ODOO_COMMIT=aec78b6bc4c266c787f9b747c1666fd41b680973
ODOO_UPSTREAM=1f2b50ade7a11e11cbcd792b5b6df439525c54d0
ODOO_DIR=/opt/odoo/18.0
CONF=/etc/odoo/odoo.conf
WKHTMLTOX_URL=https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bookworm_amd64.deb

mkdir -p /opt/odoo/extra-addons
git clone --quiet --depth 1 --branch "$ODOO_TAG" "$ODOO_URL" "$ODOO_DIR"
[ "$(git -C "$ODOO_DIR" rev-parse HEAD)" = "$ODOO_COMMIT" ]
rm -rf "$ODOO_DIR/.git"
cat > /opt/odoo/REVISION <<REV
odoo 18.0
snapshot $ODOO_COMMIT ($ODOO_URL, tag $ODOO_TAG)
upstream $ODOO_UPSTREAM (https://github.com/odoo/odoo, branch 18.0)
REV

WKHTMLTOX_DEB=/tmp/wkhtmltox.deb
curl --fail --silent --show-error --location --retry 3 --output "$WKHTMLTOX_DEB" "$WKHTMLTOX_URL"
# the digest of wkhtmltox_0.12.6.1-3.bookworm_amd64.deb, 16986150 bytes
echo "98ba0d157b50d36f23bd0dedf4c0aa28c7b0c50fcdcdc54aa5b6bbba81a3941d  $WKHTMLTOX_DEB" | sha256sum --check --status
# The libraries that it needs are in the plan. Its Depends line names libssl3,
# which libssl3t64 provides in Debian 13.
dpkg -i "$WKHTMLTOX_DEB"
rm -f "$WKHTMLTOX_DEB"
wkhtmltopdf --version | grep -q 'with patched qt'
echo "wkhtmltox 0.12.6.1-3 ($WKHTMLTOX_URL)" >> /opt/odoo/REVISION
# The upstream tree holds private keys as test fixtures and for the test
# environments of some localizations (point_of_sale, account_peppol,
# l10n_it_edi, odoo/addons/base/tests/ssl), and python3-ldap holds one in
# slapdtest. A layer is shared, so no machine built from it may hold a
# private key that every other machine holds too (bt-layer refuses it).
# Nothing at run time reads them.
# Only files that are key material are looked at, by name and by content:
# cryptography's ssh.py, for one, holds the marker as a string.
find "$ODOO_DIR" /usr/lib/python3/dist-packages -type f \
    \( -name '*.key' -o -name '*.pem' -o -name '*.key.pem' \) \
    -exec grep -lIZ -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' {} + | xargs -0r rm -f
if find "$ODOO_DIR" /usr/lib/python3/dist-packages -type f \
        \( -name '*.key' -o -name '*.pem' -o -name '*.key.pem' \) \
        -exec grep -lIZ -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' {} + | grep -qz .; then
    echo "a private key is still in the tree" >&2
    exit 1
fi
# Bytecode that depends on the source's content and not on its time, so the
# unit can run with a read only /opt and the layer's bytes do not depend on
# the time of the build.
python3 -m compileall -q -j 0 --invalidation-mode checked-hash "$ODOO_DIR/odoo" "$ODOO_DIR/addons" > /dev/null
ln -s "$ODOO_DIR/odoo-bin" /usr/bin/odoo

adduser --system --group --home /var/lib/odoo --no-create-home \
    --shell /usr/sbin/nologin odoo
install -d -o odoo -g odoo -m 0750 /var/lib/odoo
chown root:odoo "$CONF"
chmod 0640 "$CONF"

# The layers below removed the snake oil certificate that postgresql.conf
# names (the first boot makes the certificate), so the server starts here
# with TLS off, for this build step alone. The unix socket needs no TLS.
PGVER="$(ls /etc/postgresql/)"
pg_ctlcluster "$PGVER" main start -o "-c ssl=off"
# A failed step below must not leave the server running in the chroot.
trap 'pg_ctlcluster "$PGVER" main stop || true' EXIT

su postgres -c "createuser --no-superuser --no-createdb --no-createrole odoo"
su postgres -c "createdb --owner odoo --encoding UTF8 --template template0 odoo"
runuser -u odoo -- python3 "$ODOO_DIR/odoo-bin" --config "$CONF" \
    -i base --without-demo=all --stop-after-init

psql_odoo() { runuser -u odoo -- psql -X -q -At -v ON_ERROR_STOP=1 -d odoo "$@"; }

psql_odoo <<'SQL'
INSERT INTO ir_config_parameter (key, value, create_uid, write_uid, create_date, write_date)
VALUES ('ir_attachment.location', 'db', 1, 1, now(), now())
ON CONFLICT (key) DO UPDATE SET value = 'db';
SQL
# The attachments that the installation wrote (the asset bundles) are files
# until force_storage moves them into the database.
echo "env['ir.attachment'].force_storage(); env.cr.commit()" \
    | runuser -u odoo -- python3 "$ODOO_DIR/odoo-bin" shell --config "$CONF" --no-http
[ "$(psql_odoo -c "SELECT count(*) FROM ir_attachment WHERE store_fname IS NOT NULL")" = 0 ]
[ "$(psql_odoo -c "SELECT count(*) FROM ir_attachment WHERE db_datas IS NULL AND res_model IS NOT NULL AND type = 'binary'")" = 0 ]
# The installation gave the admin user the password "admin", the same in
# every image. A NULL password cannot log in. The first boot hook sets the
# password of the spec, and Odoo does not start before the hook has
# finished (usr/lib/keel-odoo/serve.py).
psql_odoo <<'SQL'
UPDATE res_users SET password = NULL WHERE login = 'admin';
SQL
# The public user is inactive and holds a random hash that nobody knows.
[ "$(psql_odoo -c "SELECT count(*) FROM res_users WHERE active AND password IS NOT NULL")" = 0 ]
# wkhtmltopdf fetches the style sheets and the images of a report from
# report.url. Without it, it uses web.base.url, which is the public address:
# it goes through Anubis and Coraza, or does not resolve, and the report
# prints with no style and no header.
psql_odoo <<'SQL'
INSERT INTO ir_config_parameter (key, value, create_uid, write_uid, create_date, write_date)
VALUES ('report.url', 'http://127.0.0.1:8069', 1, 1, now(), now())
ON CONFLICT (key) DO UPDATE SET value = 'http://127.0.0.1:8069';
SQL
# The files that the installation left are orphans now.
rm -rf /var/lib/odoo/filestore /var/lib/odoo/sessions
# The filestore stays in the image, empty. On a pair, keel writes the marker
# of a file sync folder only where the path is there, and the file sync unit
# can write only a path that is there when the unit starts. Odoo makes its
# filestore at the first file it stores, and that is too late: the folder
# was in error ("folder path missing"), keel sent a critical alert, and the
# standby could not receive a file (release A3, the two Odoo pairs,
# 2026-11-10). conf.d/zz-check requires each path that odoo.yaml replicates.
install -d -o odoo -g odoo -m 0750 /var/lib/odoo/filestore

pg_ctlcluster "$PGVER" main stop
trap - EXIT

# Odoo runs on every node: usr/lib/keel-odoo/serve.py loads it and serves on
# the node whose PostgreSQL is writable. It does not serve before the first
# boot hook has written /var/lib/keel-odoo/ready.
systemctl enable odoo.service

# The cache of the asset bundles (conf.d/keel-odoo.conf of Nginx). Nginx
# makes no parent of a cache path, and /var/cache/nginx is not in the
# image: `nginx -t` failed with "mkdir() failed" (CT 9390, 2026-11-07).
# The workers of Nginx write it.
install -d -m 0755 /var/cache/nginx
install -d -o www-data -g www-data -m 0700 /var/cache/nginx/keel-odoo-assets

# The front site of Keel Web must include keel-front.d, so an upload is not
# stopped at 1 MB behind Anubis. Since keel-web 0.4.0 (decision 0079) each
# server of the front includes a snippet, and the snippet includes the
# directory: the build on keel-web 0.4.1 stopped on the check of the site
# itself (build host, 2026-11-06). tests/stack.bats runs this block on
# keel-web's real files.
# begin: front check
FRONT=/etc/nginx/keel-front.d/60-keel-odoo.conf
SNIPPET=/etc/nginx/snippets/keel-web-front.conf
[ -f "$FRONT" ]
{ grep -qxF 'include /etc/nginx/keel-front.d/*.conf;' "$SNIPPET" \
    && grep -qxF "	include $SNIPPET;" /etc/nginx/sites-available/default-anubis; } \
    || { echo "the front site of keel-web does not include keel-front.d: keel-web 0.4.0 is the least" >&2; exit 1; }
# end: front check

# The stack check of lnpp is not part of the Odoo product: its first boot
# hook makes a test database, keel_check, and its page /keel-check/ shows
# the stack to anybody who asks (the commissioning test found both on BR1
# and BR2, 2026-11-06). They are the parent layer's, so they are removed
# here: the hook, the route, the application, the socket that lnpp
# enabled, the service unit and its user keel-check. The deck build records
# each removal as a whiteout of this layer, and keel assemble removes the
# path from the image. conf.d/zz-check proves that none is left.
#
# Until keel-lnpp 19.0-9 lnpp's manifest named the page as a process with
# the unit keel-lnpp-check.service, so the unit had to stay, and nothing
# could start it: Monit sent a critical alert on each Odoo node, and then
# stopped the watch (release A3, 2026-11-10). lnpp's manifest names no such
# process now. On an older lnpp, `keel manifest validate` below stops the
# build, because keel refuses a chain whose unit is not there.
# The preset file of lnpp stays: it disables the WAL archival of
# postgresql-common.
systemctl disable keel-lnpp-check.socket
rm -rf /usr/lib/inithooks/firstboot.d/40lnpp-check \
    /etc/nginx/keel-default.d/50-keel-lnpp.conf \
    /usr/share/keel-lnpp \
    /usr/lib/systemd/system/keel-lnpp-check.socket \
    /usr/lib/systemd/system/keel-lnpp-check.service
userdel keel-check

# The appliance manifest, validated and resolved along lnpp, web and core on
# this very tree, so a manifest the booted machine would refuse fails the
# build (the same line the WordPress layer ships).
keel manifest validate odoo
