#!/bin/bash -e
# Run by fab in the image chroot of the odoo layer, after conf.d/main. It
# changes nothing: it fails the build when the image is not what handbook
# decision 0059 says, and reports every problem it finds.
#
# - No Apache: nginx is the only web server of Keel.
# - Odoo is there, from /opt/odoo/18.0, with the revision recorded.
# - Odoo runs as its own system user with no shell. The user has no password
#   in the image or in the configuration: PostgreSQL authenticates it by peer.
# - odoo.service is enabled and runs usr/lib/keel-odoo/serve.py, which loads
#   Odoo on every node and serves on the node whose PostgreSQL is writable.
#   No second supervisor (the old follow timer) is left.
# - wkhtmltopdf is the build with patched qt: reports print with headers and
#   footers.
# - The Anubis snippet passes the Upgrade header (keel-overlay-anubis 0.1.1).
# - keel is 0.23.49 or newer (the promotion of a standby whose stream ended
#   inside a WAL record, keel#215, and the fast stop of PostgreSQL, keel#219).
# - The front site takes uploads and the Coraza rules take the JSON-RPC
#   calls of Odoo.
# - The Nginx route is in keel-web's include directory.
# - odoo.yaml is the one appliance manifest that no other is built on.
#
# KEEL_CONF_ROOT is the tree to work on, empty (the chroot's /) in a build;
# tests/image-check.bats sets it to a scratch tree.
root="${KEEL_CONF_ROOT:-}"
failed=0
APPLIANCES=/usr/share/keel/appliances
WANTS=/etc/systemd/system

fatal() {
    echo "FATAL: $*" >&2
    failed=1
}

for path in /usr/sbin/apache2 /usr/lib/systemd/system/apache2.service \
        /lib/systemd/system/apache2.service; do
    if [ -e "$root$path" ]; then
        fatal "Apache is in the image ($path): nginx is the only web server (decision 0059)"
    fi
done

if [ ! -x "$root/opt/odoo/18.0/odoo-bin" ]; then
    fatal "/opt/odoo/18.0/odoo-bin is not in the image"
fi
if [ ! -s "$root/opt/odoo/REVISION" ]; then
    fatal "/opt/odoo/REVISION is not in the image"
fi
if [ -e "$root/opt/odoo/18.0/.git" ]; then
    fatal "/opt/odoo/18.0/.git is in the image: the checkout is not for upgrades by git"
fi

user="$(grep '^odoo:' "$root/etc/passwd" 2>/dev/null || true)"
if [ -z "$user" ]; then
    fatal "odoo is not a system user of the image"
elif [ "$(cut -d: -f7 <<< "$user")" != /usr/sbin/nologin ]; then
    fatal "odoo has a shell: $user"
fi
if grep -qE '^(db_password|db_host)' "$root/etc/odoo/odoo.conf" 2>/dev/null; then
    fatal "odoo.conf names a database password or host: the peer method needs neither"
fi
if grep -qE '^admin_passwd\s*=\s*\S' "$root/etc/odoo/odoo.conf" 2>/dev/null; then
    fatal "odoo.conf holds a master password in the image"
fi

if [ ! -L "$root$WANTS/multi-user.target.wants/odoo.service" ]; then
    fatal "odoo.service is not enabled: nothing loads Odoo"
fi
if [ ! -f "$root/usr/lib/keel-odoo/serve.py" ]; then
    fatal "/usr/lib/keel-odoo/serve.py is not in the image"
fi
if [ -L "$root$WANTS/timers.target.wants/keel-odoo-follow.timer" ]; then
    fatal "keel-odoo-follow.timer is enabled: a second supervisor of Odoo"
fi

WKHTMLTOPDF=/usr/local/bin/wkhtmltopdf
if [ ! -x "$root$WKHTMLTOPDF" ]; then
    fatal "wkhtmltopdf is not in the image: reports do not print as PDF"
elif ! "$root$WKHTMLTOPDF" --version 2>/dev/null | grep -q 'with patched qt'; then
    fatal "wkhtmltopdf is not the build with patched qt: a report has no header and no footer"
fi

# keel 0.23.48 ends the drain of a promotion 2 s after a cut that ended the
# stream inside a record (keel#215). keel 0.23.49 stops PostgreSQL with a fast
# shutdown, in 120 s at most: a smart shutdown waited for the idle client that
# serve.py holds (keel#219). Older keel waits minutes or an hour.
KEEL_MIN=0.23.49
keel_init="$root/usr/lib/python3/dist-packages/keel/__init__.py"
keel_version="$(sed -n 's/^FALLBACK_VERSION = "\(.*\)"$/\1/p' "$keel_init" 2>/dev/null || true)"
if [ -z "$keel_version" ]; then
    fatal "the version of keel is not in the image"
elif [ "$(printf '%s\n%s\n' "$KEEL_MIN" "$keel_version" | sort -V | head -1)" != "$KEEL_MIN" ]; then
    fatal "keel $keel_version is older than $KEEL_MIN: a promotion or a stop of PostgreSQL can wait minutes to an hour (keel#215, keel#219)"
fi

if [ ! -f "$root/etc/nginx/keel-front.d/60-keel-odoo.conf" ]; then
    fatal "the body limit of the front site is not in keel-front.d: an upload stops at 1 MB behind Anubis"
fi
if ! grep -qF 'proxy_set_header Upgrade $http_upgrade;' "$root/etc/nginx/snippets/keel-anubis.conf" 2>/dev/null; then
    fatal "the Anubis snippet does not pass the Upgrade header: keel-overlay-anubis 0.1.1 is the least (Odoo needs the bus behind Anubis)"
fi
for rules in before after; do
    if [ ! -f "$root/etc/coreruleset/plugins/keel-odoo-$rules.conf" ]; then
        fatal "keel-odoo-$rules.conf is not in the image"
    fi
done

if [ ! -f "$root/etc/nginx/keel-default.d/60-keel-odoo.conf" ]; then
    fatal "the Nginx route of Odoo is not in keel-web's include directory"
fi

if [ ! -f "$root$APPLIANCES/odoo.yaml" ]; then
    fatal "$APPLIANCES/odoo.yaml is not in the image"
fi
for name in postgresql mariadb; do
    if [ -e "$root$APPLIANCES/$name.yaml" ]; then
        fatal "$APPLIANCES/$name.yaml is in the image: a second manifest, so keel inspect cannot name the appliance"
    fi
done

exit "$failed"
