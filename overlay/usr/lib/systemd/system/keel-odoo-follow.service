[Unit]
Description=Odoo follows the writable PostgreSQL (Keel)
After=postgresql.service

[Service]
Type=oneshot
# The timer fires every 3 seconds. Only an action and a problem belong in the
# journal: the script marks an action "notice" and a problem "warning", and
# a line with no mark, such as a traceback, is "err".
LogLevelMax=notice
SyslogLevel=err
ExecStart=/usr/bin/python3 /usr/lib/keel-odoo/follow.py
