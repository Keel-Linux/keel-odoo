# Odoo 18.0 (handbook decision 0059). The unit runs on every node. Its
# process (usr/lib/keel-odoo/serve.py) imports Odoo, waits, and serves only
# while PostgreSQL accepts writes: a standby refuses the writes that Odoo
# makes. While it waits it holds no listener and no database connection that
# writes.
[Unit]
Description=Odoo (Keel)
After=postgresql.service
# serve.py decides, so a start that fails does not count against a limit.
StartLimitIntervalSec=0

[Service]
Type=simple
User=odoo
Group=odoo
ExecStart=/usr/bin/python3 /usr/lib/keel-odoo/serve.py
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
ProtectSystem=strict
ReadWritePaths=/var/lib/odoo
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
